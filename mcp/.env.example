# Aegir MCP server configuration.
#
# Copy to .env and fill in. The server reads exactly these two variables and nothing else.

# Base URL of the Aegir API, including the path base.
AEGIR_BASE_URL=https://api.aegir.foxlinindustries.com/apis

# Developer key, in the form devKeyId:secret.
#
# On start-up the server exchanges this for a scope-narrowed access token and uses that for the
# rest of the session, so the long-lived key is presented once rather than on every request.
AEGIR_DEVELOPER_KEY=replace-me

# AEGIR_CONFIG_KEY is deliberately NOT read.
#
# It was removed in Beta-1. The API no longer accepts it as a credential on any identity-bearing
# route, and it still opens the pre-authentication federation and handoff routes - so placing it
# in a client process is exposure with no benefit. Do not add it back.
