      "inspectionTool",
      "inspectionHost",
      "inspectionTransport",
      "inspectionVersion"
    ],
    "host": "aegir.managed-http.v1",
    "transport": "aegir-custom-http-jsonrpc",
    "version": "aegir.mcp.security-contract/v1",
    "freshHumanConsent": true
