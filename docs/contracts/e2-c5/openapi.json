            "const": "totp.consent"
          },
          "approvalPolicy": {
            "type": "string",
            "const": "CurrentPlatformReviewAndApprovalThenScopedHumanEnablement"
          },
          "runtimeCompatibility": {
            "const": "aegir.c5.builtin-mcp-security-inspection/v1"
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 253402300799
          }
