          "schema",
          "skillId",
          "family",
          "version",
          "publisher",
          "application",
          "organization",
          "description",
          "adapter",
          "adapterDigest",
          "resource",
          "scopes",
          "sideEffects",
          "inputSchema",
          "outputSchema",
          "maximumInputBytes",
          "maximumOutputBytes",
          "maximumMilliseconds",
          "humanAssurance",
