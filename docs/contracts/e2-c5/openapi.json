          }
        },
        "required": [
          "outcome",
          "executionId",
          "grantId",
          "isReplay",
          "metadata",
          "resultDigest",
          "delivery"
        ],
        "description": "Only initial admitted execution returns metadata. Duplicate execute and explicit status preserve operation identity and nonsecret terminal truth without private redisclosure. Missing evidence is Unknown/recovery-required, never Abort."
      },
      "McpSecurityExecutionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "aegir.mcp-security-skill.execution/v1"
          },
          "result": {
            "$ref": "#/components/schemas/McpSecurityExecutionResult"
          }
        },
        "required": [
          "schema",
          "result"
        ]
