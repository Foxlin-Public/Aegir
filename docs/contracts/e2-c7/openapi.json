          },
          "installationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "installationApprovalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$",
            "const": "CommittedRead"
          },
          "commitmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "executedAtUtc": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "signedAtUtc": {
            "type": "string",
            "minLength": 1,
