            "pattern": "^[ -~]+$"
          },
          "resultCommitment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "algorithm": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "signingKeyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "signerPrincipal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$",
