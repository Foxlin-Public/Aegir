              "null"
            ]
          },
          "isReplay": {
            "type": "boolean"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "New authorized read only: resourceAlias, depth and status. Never historical re-disclosure."
          },
          "receipt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Receipt"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "type": "string"
          },
          "grantsAuthority": {
            "const": false
          },
          "clientDelivery": {
            "const": "unproven"
          }
        }
      }
