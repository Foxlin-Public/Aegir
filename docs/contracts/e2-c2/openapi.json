  "components": {
    "schemas": {
      "C2Agent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agentId": {
            "type": "string",
            "maxLength": 160
          },
          "credentialId": {
            "type": "string",
            "maxLength": 160
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "agentId",
          "credentialId",
          "epoch"
        ]
      },
      "C2Child": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "action": {
            "enum": [
              "issue",
              "inspect",
              "revoke",
              "suspend"
            ]
          },
          "parentId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "targetAgentId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "resourcePolicy": {
            "anyOf": [
              {
                "enum": [
                  "self.account.metadata.read",
                  "group.administration.metadata.read"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "resourceAlias": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "scopes": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "maximumUses": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 253402300799
              },
              {
                "type": "null"
              }
            ]
          },
          "subjectId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{32}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "requestId",
          "action",
          "parentId",
          "targetAgentId",
          "resourcePolicy",
          "resourceAlias",
          "scopes",
          "maximumUses",
          "expiresAt",
          "subjectId"
        ]
      },
      "C2Definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "aegir.installed-skill-chain-root-t1/v4"
          },
          "allocationMode": {
            "const": "exclusive-child-reservation-no-automatic-refund/v1"
          },
          "maximumEdges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "maximumChildren": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "maximumUses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "agents": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/C2Agent"
            }
          },
          "skill": {
            "$ref": "#/components/schemas/C2SkillPin"
          }
        },
        "required": [
          "schema",
          "allocationMode",
          "maximumEdges",
          "maximumChildren",
          "maximumUses",
          "agents",
          "skill"
        ]
      },
      "C2Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "outcome"
        ]
      },
      "C2InstallationCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "action": {
            "enum": [
              "install",
              "reinstall",
              "upgrade",
              "enable",
              "suspend",
              "uninstall",
              "inspect",
              "status"
            ]
          },
          "application": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "organization": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "group": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "installationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "predecessorId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "skillKey": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "manifestDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "adapterDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
