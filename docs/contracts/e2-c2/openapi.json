                "maximum": 253402300799
              },
              {
                "type": "null"
              }
            ]
          },
          "purpose": {
            "anyOf": [
              {
                "enum": [
                  "skills:installation:install:v1",
                  "skills:installation:reinstall:v1",
                  "skills:installation:upgrade:v1",
                  "skills:installation:enable:v1",
                  "skills:installation:suspend:v1",
                  "skills:installation:uninstall:v1"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "totpCode": {
            "anyOf": [
